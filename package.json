{
  "name": "edersonalmeida",
  "version": "0.1.0",
  "private": true,
  "description": "Portal jurídico — Vite (Vercel) + Fastify + PostgreSQL (Render)",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev --workspace @edersonalmeida/web\" \"npm run dev --workspace @edersonalmeida/api\"",
    "dev:web": "npm run dev --workspace @edersonalmeida/web",
    "dev:api": "npm run dev --workspace @edersonalmeida/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @edersonalmeida/web",
    "vercel-build": "npm run build:web",
    "build:api:render": "npm run prisma:generate --workspace @edersonalmeida/api && npm run build --workspace @edersonalmeida/api",
    "start:api": "npm run start --workspace @edersonalmeida/api",
    "prisma:generate": "npm run prisma:generate --workspace @edersonalmeida/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @edersonalmeida/api",
    "prisma:seed": "npm run prisma:seed --workspace @edersonalmeida/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
